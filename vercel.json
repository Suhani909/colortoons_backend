{
    "version": 2,
    "builds": [
        {
            "src": "src/index.js",
            "use": "@vercel/node@3"
        }
    ],
    "routes": [
        {
            "src": "/(.*)",
            "dest": "src/index.js"
        }
    ],
    "functions": {
        "src/index.js": {
            "runtime": "nodejs24.x"
        }
    }
}